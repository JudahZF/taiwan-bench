# Frontend (Vite). `npx convex dev` writes VITE_CONVEX_URL to .env.local for you.
VITE_CONVEX_URL=
# Optional. Without it the site is read-only: no sign-in, no new runs from the GUI.
VITE_CLERK_PUBLISHABLE_KEY=

# Backend vars live on the Convex deployment, not in this file:
#   npx convex env set OPENROUTER_API_KEY sk-or-...
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
